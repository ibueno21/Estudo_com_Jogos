# ── Modelo de configuração (NÃO contém segredos reais) ──────
# Copie este arquivo para `.env` e preencha com os valores reais.
#   cp .env.example .env
# O `.env` NÃO é versionado no git.

# Chave secreta do Django (gere uma nova com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=troque-por-uma-chave-secreta

# Banco de dados MySQL
DB_NAME=bd_prof_isaac
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306

# Debug (True em desenvolvimento, False em produção)
DEBUG=True
